{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "server.js"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/birthday",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/flight-schedule",
      "schedule": "45 19 * * *"
    }
  ]
}