# Copy to .env and fill in. Everything except Firebase and SMTP has a working
# fallback, so the app boots with none of this set.

# --- Firestore. Without these, carpool state is in-memory and the directory is empty.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Email. Without these nothing is sent.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Signs admin sessions. MUST be set in production: the random fallback
# differs per serverless instance, so tokens break between requests.
JWT_SECRET=

# --- Guards /api/cron/*. The endpoint refuses to run without it.
CRON_SECRET=

# --- Flight data. Without a key the app serves canned flights.
# AeroDataBox via RapidAPI: rapidapi.com/aedbx-aedbx/api/aerodatabox
FLIGHT_API_KEY=
# stub | blr-aodb | leave unset for AeroDataBox
FLIGHT_PROVIDER=

# --- Drive time. Without these the picker uses a flat estimate.
GOOGLE_MAPS_API_KEY=
HOSTEL_LATLNG=
HOSTEL_TRAVEL_MINUTES=90

# --- Admin bypass code.
ADMIN_DEFAULT_OTP=

# --- Demo login for people with no student record. Disabled unless both are set.
DEMO_USN=
DEMO_OTP=

# --- Base URL used in email links.
PUBLIC_BASE_URL=

# --- Set to 1 to run a birthday check on boot. Off by default: it used to fire
# on every nodemon restart and every serverless cold start.
BIRTHDAY_RUN_ON_START=
